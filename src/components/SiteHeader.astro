---
import { nav, site } from '../data/site';
---

<header class="site-header mono" data-over="split" data-header>
  <a class="brand" href="#top" aria-label={`${site.name}, back to top`}>{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
  <button class="menu-btn mono" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>Menu</button>
</header>

<div class="menu" id="menu" data-theme="dark" role="dialog" aria-modal="true" aria-label="Menu" data-menu>
  <div class="menu__top mono">
    <span>{site.name}</span>
    <button type="button" data-menu-close>Close</button>
  </div>
  <ul>
    {nav.map((item) => <li><a href={item.href} data-menu-link>{item.label}</a></li>)}
  </ul>
  <p class="mono eyebrow">{site.role}, {site.city}</p>
</div>
