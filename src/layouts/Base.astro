---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import sans500 from '@fontsource/instrument-sans/files/instrument-sans-latin-500-normal.woff2?url';
import sans400 from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import { agents, site, work } from '../data/site';
import { media } from '../data/media';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = media.og;
// Visit counts with Vercel Web Analytics (no cookies). Only in builds on Vercel, where its
// routes exist; the CI checks build without it and stay the same.
const analytics = process.env.VERCEL === '1';
// every page points AI assistants to their own page; that page also offers itself as Markdown
const onAgentsPage = Astro.url.pathname.replace(/\/$/, '') === agents.path;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.name,
      jobTitle: site.role,
      url: site.url,
      description: site.description,
      address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad Politécnica de Madrid' },
      knowsAbout: [
        'Autonomous AI agents',
        'Agent verification and evals',
        'AI governance',
        'Generative engine optimization',
        'Enterprise AI strategy',
      ],
      sameAs: [site.linkedin, site.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      inLanguage: 'en',
      publisher: { '@id': `${site.url}/#person` },
    },
    {
      '@type': 'ItemList',
      name: work.title,
      itemListElement: work.items.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.name,
        description: p.text,
        url: p.links[0]?.href,
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F5F2EB" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="help" href={agents.path} title={agents.label} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="application/json" href="/contact.json" title={`${agents.label}, as data`} />
    {onAgentsPage && <link rel="alternate" type="text/markdown" href="/agents.md" title={`${agents.label}, as Markdown`} />}
    <link rel="preload" href={sans500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kit, a green fox made of blocks, next to the words Autonomy by design." />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    {analytics && <Analytics />}

    <script is:inline>
      // before paint: enable JS-only styles and restore the visitor's motion choice
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (localStorage.getItem('motion') === 'paused') d.classList.add('motion-paused');
        } catch (e) {}
        // if the page script never runs, show everything instead of waiting for reveals
        setTimeout(function () {
          if (!d.hasAttribute('data-ready')) d.classList.remove('js');
        }, 3500);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
